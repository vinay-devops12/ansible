
- name: course information
  hosts: localhost
  connection: local
  vars:
   course: "devops and aiops"  ## string
   duration_in_hrs: 150  ## int
   is_it_live: true  ## bollen
   topics:
    - linux
    - shell
    - ansible
    - git
   more_details:
    month: 5   ## map
    trainer: vinay  
  tasks:
   - name: print information  
     ansible.builtin.debug:
      msg:
       name: "{{ course }}"
       duration: "{{ duration_in_hrs }}"
       live: "{{ is_it_live }}"
       topics: "{{ topics }}"
       more_details: "{{ more_details }}"

