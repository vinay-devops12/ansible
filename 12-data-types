
---
- name: course information
  hosts: local
  connection: local
  vars:
   course: "devops and aiops"  ## string
   duration-in_hrs: 150  ## int
   is_it_live: true  ## bollen
   topics:
    linux
    shell
    ansible
    git
   more_datails:
    month: 5   ## map
    trainer: vinay  
  tasks:
   - name: print information  
     debug:
      msg:
       name: {{ course }}
       duration: {{ duration-in_hrs }}
       live: {{ is_it_live }}
       topics: {{ topics }}
       more_datails: {{ more_datails }}

